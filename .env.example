# Copy to .env and adjust. PUID/PGID must match the owner of ./data,
# otherwise SQLite cannot create its files inside the volume.
#
#   mkdir -p data
#   cp .env.example .env
#   sed -i "s/^PUID=.*/PUID=$(id -u)/; s/^PGID=.*/PGID=$(id -g)/" .env
PUID=1000
PGID=1000

# Port published on the host (nginx proxies to it).
SHORTY_PORT=8080

# Public origin for the links that come back from /api/condense.
# Leave empty to derive it from Host / X-Forwarded-* headers.
SHORTY_BASE_URL=
