# Copy to .env and adjust. PUID/PGID must match the owner of ./data,
# otherwise SQLite cannot create its files inside the volume.
#
#   mkdir -p data
#   cp .env.example .env
#   sed -i "s/^PUID=.*/PUID=$(id -u)/; s/^PGID=.*/PGID=$(id -g)/" .env
PUID=1000
PGID=1000

# Internal network: nothing is published on the host, nginx talks to
# SHORTY_IP:8080 directly. Pick a subnet that does not clash with your other
# docker networks (172.17-172.26, 172.30 and 172.79/172.89 are taken here).
# Docker gives the bridge the first address in the subnet (172.31.0.1); no
# gateway is needed because an internal network has no default route.
SHORTY_SUBNET=172.31.0.0/24
SHORTY_IP=172.31.0.10

# Public origin for the links that come back from /api/condense.
# Leave empty to derive it from Host / X-Forwarded-* headers.
SHORTY_BASE_URL=
